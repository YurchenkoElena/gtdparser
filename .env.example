# ===========================================
# GTD Parser - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=production
PORT=3000
APP_PORT=3000

# ===========================================
# Authentication Tokens
# ===========================================
# Token for incoming webhook requests from Bitrix24
INBOUND_AUTH_TOKEN=your-secret-webhook-token

# Token for accessing job status API
JOB_STATUS_TOKEN=your-secret-status-token

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_EXTERNAL_PORT=6379

# ===========================================
# Worker Configuration
# ===========================================
# Number of concurrent workers processing jobs
WORKER_CONCURRENCY=2

# ===========================================
# Temporary Files
# ===========================================
TMP_DIR=/tmp/gtdparser

# ===========================================
# Idempotency
# ===========================================
# TTL for idempotency keys in seconds (default: 180 days = 15552000)
IDEMPOTENCY_TTL=15552000

# ===========================================
# Bitrix24 Configuration
# ===========================================
# Base URL of your Bitrix24 portal
BITRIX_BASE_URL=https://your-portal.bitrix24.ru

# Webhook URL for REST API access
# Format: https://your-portal.bitrix24.ru/rest/USER_ID/WEBHOOK_CODE/
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/your-webhook-code/

# UF field code for deal status (e.g., "Обработано", "Ошибка")
BITRIX_DEAL_STATUS_FIELD_CODE=UF_GTD_STATUS

# UF field code for storing result XLSX file ID
BITRIX_RESULT_FILE_FIELD_CODE=UF_GTD_RESULT_FILE

# UF field code for comments (optional)
BITRIX_COMMENT_FIELD_CODE=UF_GTD_COMMENT

# ===========================================
# Adobe PDF Services
# ===========================================
# Get credentials at: https://developer.adobe.com/document-services/
ADOBE_CLIENT_ID=your-adobe-client-id
ADOBE_CLIENT_SECRET=your-adobe-client-secret

# ===========================================
# Field Mapping
# ===========================================
# Path to mapping.json file (relative to project root or absolute)
MAPPING_FILE_PATH=./config/mapping.json

# ===========================================
# Data Validation
# ===========================================
# Comma-separated list of required GTD graph numbers
# If these fields are not found, job will fail with VALIDATION_FAILED
REQUIRED_FIELDS=1,31,47
